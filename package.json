{
  "name": "si-stilist",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/ensure-db.mjs",
    "dev": "next dev",
    "build": "next build",
    "prestart": "node scripts/ensure-db.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "postinstall": "prisma generate",
    "setup": "node scripts/setup.mjs",
    "check:ai": "tsx scripts/check-ai.ts",
    "check:tryon": "tsx scripts/check-tryon.ts",
    "db:start": "prisma dev --name si_stilist --db-port 51214 --detach",
    "db:stop": "prisma dev stop si_stilist",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:setup": "prisma migrate deploy && prisma db seed",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "images:placeholders": "tsx scripts/generate-placeholders.ts",
    "images:prompts": "tsx scripts/generate-photo-prompts.ts",
    "images:apply": "tsx scripts/apply-product-photos.ts",
    "tryon:prepare": "tsx scripts/prepare-tryon-demo.ts",
    "tryon:model": "tsx scripts/make-demo-model.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fal-ai/client": "^1.10.1",
    "@google/genai": "^2.27.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "next": "16.3.8",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
