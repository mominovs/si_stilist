# PostgreSQL.
# Standart: Prisma'ning lokal serveri (npm run db:start), Docker shart emas.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
# Docker bilan (docker compose up -d):
# DATABASE_URL="postgresql://stilist:stilist@localhost:5432/si_stilist?schema=public"
# Onlayn (Neon va h.k.): xizmat bergan manzilni shu yerga qo'ying

# /admin uchun parol (login: istalgan, parol: shu qiymat)
ADMIN_PASSWORD="demo123"

# LLM (2-bosqich)
ANTHROPIC_API_KEY=""
LLM_MODEL="claude-haiku-4-5-20251001"
# Sekin internetda SI kutish vaqtini oshirish (ms). Tekshirish: npm run check:ai
# LLM_TIMEOUT_MS=12000
# Kunlik SI so'rovlari chegarasi (byudjet himoyasi), keyin oddiy tahlil ishlaydi
# LLM_DAILY_LIMIT=500
# Sayt internetga ochiq bo'lsa (run-all.bat) 100 tavsiya etiladi

# Jonli oyna seansi, soniya (standart 60; lokal model bepul, demo uchun 180 qulay)
# MIRROR_SESSION_SECONDS=180

# Internetga ochish (run-all.bat, ngrok): dashboard.ngrok.com -> Domains dagi tekin doimiy manzil
# NGROK_DOMAIN=sizning-nom.ngrok-free.dev

# Rasm orqali kiyintirish (4-bosqich). Provayder: GEMINI_API_KEY bo'lsa Gemini, aks holda fal.ai
# Majburan tanlash: TRYON_PROVIDER=local | gemini | fal
# local: o'z kompyuterdagi bepul CatVTON serveri (tryon-local/README.md)
# TRYON_LOCAL_URL="http://127.0.0.1:8001"
GEMINI_API_KEY=""
# TRYON_GEMINI_MODEL="gemini-3.1-flash-image"
FAL_KEY=""
TRYON_ENDPOINT="fal-ai/kling/v1-5/kolors-virtual-try-on"
# Muqobil: fal-ai/fashn/tryon/v1.6 (adapter tayyor). Tekshirish: npm run check:tryon
# Shundan uzoq kutilsa demo rejim (ms) va kunlik pullik kiyintirishlar chegarasi
# TRYON_TIMEOUT_MS=45000
# TRYON_DAILY_LIMIT=40

# Real vaqtli kiyintirish (6-bosqich)
DECART_API_KEY=""
